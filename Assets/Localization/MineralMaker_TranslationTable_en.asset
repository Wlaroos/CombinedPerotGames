  m_TableData:
  - m_Id: 3919710728193
    m_Localized: Drag the element and compound ingredients to the cave.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728194
    m_Localized: Tap ADD PRESSURE to craft the mineral.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728195
    m_Localized: Choose a mineral.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728196
    m_Localized: 'Successful Crafts:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728197
    m_Localized: 'Make this mineral:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728198
    m_Localized: 'Ingredients:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728199
    m_Localized: 'Product:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728200
    m_Localized: ADD PRESSURE
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728201
    m_Localized: Oops, you created slag! Try Again!
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728202
    m_Localized: Slag is made when we melt elements or compounds together that do
      not form a mineral. In nature, this would be most like cooling lava.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728203
    m_Localized: Tap anywhere to continue.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728204
    m_Localized: Congratulations! or Great work! Or You did it!
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728192
    m_Localized: Follow the mineral recipe shown on the left.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728205
    m_Localized: 'You successfully crafted these minerals:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728206
    m_Localized: Tap Here to Restart
    m_Metadata:
      m_Items: []
