  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FunFacts_TranslationTable_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 08a12ef125354d4479d8ebf767c78d49, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 55498452992
    m_Localized: 'Aquamarine is the birthstone for March. Aquamarine''s name comes
      from the Latin for "seawater".

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498452993
    m_Localized: Aragonite is the main mineral that makes up pearls.
    m_Metadata:
      m_Items: []
  - m_Id: 55498452994
    m_Localized: "The deep blue of azurite comes from copper. Azurite is often found
      with Malachite, another copper mineral. \n"
    m_Metadata:
      m_Items: []
  - m_Id: 55498452995
    m_Localized: 'Some specimens of barite can fluoresce, or glow, under UV light. '
    m_Metadata:
      m_Items: []
  - m_Id: 55498452996
    m_Localized: 'Cut and polished benitoite is the official state gem of California.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498452997
    m_Localized: Calcite is the main mineral that makes up limestone.
    m_Metadata:
      m_Items: []
  - m_Id: 55498452998
    m_Localized: "The name chrysocolla is from the Greek words chrysos, meaning \u201Cgolden,\u201D
      and kolla, meaning \u201Cglue\u201D."
    m_Metadata:
      m_Items: []
  - m_Id: 55498452999
    m_Localized: Yellow quartz is called citrine.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453000
    m_Localized: 'The addition of cobalt turns calcite pink. Cobaltoan Calcite can
      be easily scratched and dissolves in weak acids like vinegar. '
    m_Metadata:
      m_Items: []
  - m_Id: 55498453001
    m_Localized: Cuprite is known as "ruby copper" for its intense red color.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453002
    m_Localized: When heated, dioptase generates an electric charge.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453003
    m_Localized: 'Single crystals of elbaite can show several colors. "Watermelon"
      elbaites have a pink center surrounded by a green exterior.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453004
    m_Localized: 'In most cases, high quality emeralds are rarer than diamonds. '
    m_Metadata:
      m_Items: []
  - m_Id: 55498453005
    m_Localized: 'Fluorite comes in every color of the rainbow!

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453007
    m_Localized: 'Commonly known as ''rock salt'', halite is the same salt you use
      for cooking!

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453008
    m_Localized: Hematite is one of the most abundant sources of iron ore on Earth.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453009
    m_Localized: 'Malachite is a vibrant green color and has been used as a green
      pigment for thousands of years. '
    m_Metadata:
      m_Items: []
  - m_Id: 55498453010
    m_Localized: Morganite is the pink variety of the mineral beryl.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453011
    m_Localized: Because of its shiny, metallic yellow color, pyrite is often called
      "fool's gold". Pyrite can grow in perfect cubes.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453012
    m_Localized: 'Pyromorphite typically fluoresces yellow to orange under ultraviolet
      light.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453013
    m_Localized: "Quartz is one of the most common minerals in the Earth's crust.
      \n"
    m_Metadata:
      m_Items: []
  - m_Id: 55498453014
    m_Localized: Polished slices from a rhodochrosite stalactite show patterns similar
      to tree rings.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453015
    m_Localized: Rose Quartz has been linked to various myths and legends, often
      associated with love, beauty, and healing rituals
    m_Metadata:
      m_Items: []
  - m_Id: 55498453016
    m_Localized: Rubies get their red color from trace amounts of chromium.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453017
    m_Localized: Scheelite brightly fluoresces under ultraviolet light.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453018
    m_Localized: 'Rare gemstone-quality serandite is only found in Quebec, Canada.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453020
    m_Localized: 'When cut, sodalite may release a "rotten egg" smell due to traces
      of water and sulfur.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453021
    m_Localized: Stibnite is heavy for its size, but also very soft, making it challenging
      to move without damaging it.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453023
    m_Localized: Tanzanite, a variety of Zoisite, is named after the only place it
      is found - Tanzania!
    m_Metadata:
      m_Items: []
  - m_Id: 55498453024
    m_Localized: 'The rarest colors of topaz are pink and reddish orange hues, known
      as Imperial Topaz. / Blue topaz is the Texas state gemstone!

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453025
    m_Localized: 'Vanadinite contains toxic elements vanadium and lead.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55498453026
    m_Localized: Vivianite darkens when exposed to sunlight, turning a deep blue-green
      to purplish-black.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453027
    m_Localized: 'Wulfenite is the official state mineral of Arizona.

'
    m_Metadata:
      m_Items: []
  - m_Id: 55481675776
    m_Localized: Ancient Greeks and Romans believed this purple stone could help
      them avoid a hangover
    m_Metadata:
      m_Items: []
  - m_Id: 55498453006
    m_Localized: All drywall is made out of Gypsum.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453019
    m_Localized: Siderite can be a bio-mineral produced by fungi.
    m_Metadata:
      m_Items: []
  - m_Id: 55498453022
    m_Localized: Strengite's bright color comes from ferric ions. It's named after
      Streng. The best strengites are raspberry red.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
