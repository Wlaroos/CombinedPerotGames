  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: MixedMineral_TranslationTable_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 62e1eee6caaf95847a66fcd5ff81a267, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1050416721920
    m_Localized: Ayuda a organizar estes minerales!
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721921
    m_Localized: Clasificar por Dureza
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721922
    m_Localized: Clasificar por Estructura Cristalina
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721923
    m_Localized: 'Usa este herramienta para cheqar la dureza de los minerales. Organiza
      los del mas mullido al mas duro. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721924
    m_Localized: 'Pone esta herramienta en el mineral para leer el valor de dureza. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721925
    m_Localized: "Los cient\xEDficos usan la Escala de Mohs (1 \xE1 10) para medir
      la dureza de minerales. Dureza es decidido de que puede rasgu\xF1ar una mineral.
      El mineral es suficientemente mullido para rasgu\xF1arlo con una u\xF1a, o
      es tan duro que solo una diamante puede rasgu\xF1arlo? Lo mas alto el n\xFAmero,
      lo mas duro el mineral. "
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721930
    m_Localized: "Esta herramienta ficticio toma el lugar de muchos art\xEDculos
      posibles que usan para examinar dureza en la Escala de Mohs. La esfera ense\xF1a
      en nivel de dureza de el mineral. "
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721931
    m_Localized: 'Usa esta herramienta para revelar el patron escondido de cada mineral. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721932
    m_Localized: 'Pone esta herramienta en el mineral para escanear la estructura
      cristalina. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721933
    m_Localized: "Estructura cristalina es la manera que los \xE1tomos son organizados
      dentro de un mineral. Los \xE1tomos montan juntos en un patr\xF3n de repetic\xEDon
      que determinar como un mineral se ve en la afuera. "
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721934
    m_Localized: "Este es una m\xE1quina peque\xF1a XRD. Este herramienta ficticio
      es basado en un m\xE1quina XRD (El Rayo X Difract\xF3metro). M\xE1quinas XRD
      usan rayos X para analizar y medir la estructura de materiales. "
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721935
    m_Localized: Que es la dureza?
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721936
    m_Localized: Que es estructura cristalina?
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721937
    m_Localized: Que es esta herramienta?
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721938
    m_Localized: Retroceder
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721939
    m_Localized: Continuar
    m_Metadata:
      m_Items: []
  - m_Id: 1050387361792
    m_Localized: Minerales Mezcaldos
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721926
    m_Localized: 'Este numero indica en nivel corriente de dureza. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721927
    m_Localized: "Este indica si puede rasgu\xF1ar por LEDs rojos o verdes."
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721928
    m_Localized: Pone este aguja en un mineral para leer lo.
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721929
    m_Localized: 'Gira la rueda para cambiar el nivel de dureza. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721940
    m_Localized: Clasificar por Dureza
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721941
    m_Localized: Clasificar por Estructura Cristalina
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721942
    m_Localized: 'Algunos minerales son en los botes incorrectos. '
    m_Metadata:
      m_Items: []
  - m_Id: 1050416721943
    m_Localized: 'Ninguna orden se igualan. '
    m_Metadata:
      m_Items: []
