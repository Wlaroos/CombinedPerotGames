  m_TableData:
  - m_Id: 3919710728193
    m_Localized: Arrastrar los ingredientes del elemento y el compuesto a la cueva.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728194
    m_Localized: Toca PRESIONA para crear el mineral.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728195
    m_Localized: Elige tu mineral.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728196
    m_Localized: 'Creaciones existosas. '
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728197
    m_Localized: 'Crear este mineral:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728198
    m_Localized: 'Ingredientes:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728199
    m_Localized: 'Producto:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728200
    m_Localized: Presiona!
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728201
    m_Localized: Uy, creiste escoria! Una vez mas!
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728202
    m_Localized: Escoria es hecho cuando los elementos o compuestos se funden juntos
      que no forman un mineral. De naturaleza, esta seria como lava de enfriamiento.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728203
    m_Localized: 'Toca la pantalla para continuar. '
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728204
    m_Localized: Felicidades!
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728192
    m_Localized: Usa la receta del mineral que esta en la izquierda.
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728205
    m_Localized: 'Creiste este minerales satisfactoriamente:'
    m_Metadata:
      m_Items: []
  - m_Id: 3919710728206
    m_Localized: 'Toca aqui para reiniciar. '
    m_Metadata:
      m_Items: []
